iper-pagination\",\r\n                        clickable: true,\r\n                    },\r\n                });\r\n            </script>\r\n        </div>\r\n\r\n        <!-- banner_scroll -->\r\n        <div class=\"banner_scroll\">\r\n            <a href=\"#about\">\r\n                <img src=\"web/index/images/banner_scroll.png\" alt=\"\">\r\n            </a>\r\n        </div>\r\n\r\n    </div>\r\n\r\n\r\n    <div class=\"\" id=\"about\"></div>\r\n\r\n    <!-- 首頁關於我們區 -->\r\n    <div class=\"index_aboutBg\">\r\n\r\n        <!-- 首頁關於我們背景圖 -->\r\n        <div class=\"index_aboutArea\"\r\n             style=\"background-image: url(/uploads/index_about/tw/about_pic.png);\">\r\n\r\n            <!-- 首頁關於我們右側 -->\r\n            <div class=\"index_aboutRight\" id=\"index_aboutRight\"\r\n                 data-aos=\"fade-left\"\r\n                 data-aos-delay=\"800\"\r\n                 data-aos-duration=\"1000\"\r\n                 data-aos-anchor=\"#index_aboutRight\"\r\n                 data-aos-anchor-placement=\"bottom\"\r\n                 data-aos-once=\"true\"\r\n                 data-aos-easing=\"ease-in-sine\">\r\n                <div class=\"index_aboutRightIn\">\r\n                    <div class=\"index_tit\">\r\n                        <h3>關於麗正</h3>\r\n                        <h4>『世界整流器領導地位 』</h4>\r\n                    </div>\r\n                    <div class=\"text\">\r\n                        <p>麗正國際科技股份有限公司為首位以國人資金、國人技術製造半導體矽整流器之企業。 經過近四十年整流器專業生產至今，麗正公司專注自有品牌生產及推廣，以其四十餘年來累積之豐富經驗之作業人員與忠於職務之管理人員，是投入生產、服務客戶，麗正公司維持其世界整流器領導地位之最大資產與保證。</p></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n    </div>\r\n\r\n    <!-- 首頁服務項目區 -->\r\n    <div class=\"index_serviceBg\">\r\n\r\n        <div class=\"wrap\">\r\n\r\n            <div class=\"index_tit\">\r\n                <h3>產品應用品質</h3>\r\n                <h4>『 經驗領先全球 』</h4>\r\n            </div>\r\n\r\n            <div class=\"index_serviceArea\">\r\n                <!-- 產品及服務列表 -->\r\