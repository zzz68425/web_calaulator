aos-delay=\"1800\" \r\n                                        data-aos-duration=\"1000\" \r\n                                        data-aos-anchor=\"#index_aboutPic\"\r\n                                        data-aos-anchor-placement=\"bottom\" \r\n                                        data-aos-once=\"true\"\r\n                                        data-aos-easing=\"ease-in-sine\">\r\n                <img src=\"web/index/images/about_pic2.png\" alt=\"\">\r\n            </div>\r\n\r\n            <!-- 首頁關於我們背景圖 -->\r\n            <div class=\"index_aboutArea\" style=\"background-image: url(web/index/images/about_pic.png);\">\r\n                \r\n                <!-- 首頁關於我們右側 -->\r\n                <div class=\"index_aboutRight\"   id=\"index_aboutRight\" \r\n                                                data-aos=\"fade-left\" \r\n                                                data-aos-delay=\"800\" \r\n                                                data-aos-duration=\"1000\" \r\n                                                data-aos-anchor=\"#index_aboutRight\"\r\n                                                data-aos-anchor-placement=\"bottom\" \r\n                                                data-aos-once=\"true\"\r\n                                                data-aos-easing=\"ease-in-sine\">\r\n                    <div class=\"index_aboutRightIn\">\r\n                        <div class=\"index_tit\">\r\n                            <h3>Dexin</h3>\r\n                            <h4>提供人性與科技之間的橋樑</h4>\r\n                        </div>\r\n                        <div class=\"text\">\r\n                            </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n        </div>\r\n\r\n        <!-- 首頁服務項目區 -->\r\n        <div class=\"index_serviceBg\">\r\n\r\n            <div class=\"wrap\">\r\n\r\n                <div class=\"index_tit\">\r\n                    <h3>產品及服務</h3>\r\n                    <h4>