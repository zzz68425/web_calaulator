uerySelector(\".ai_solution_area .btn\");\r\n\r\n                    // 滑鼠移上 → 停止動畫\r\n                    btn.addEventListener(\"mouseenter\", () => {\r\n                        btn.style.animationPlayState = \"paused\";\r\n                    });\r\n\r\n                    // 滑鼠移出 → 恢復動畫\r\n                    btn.addEventListener(\"mouseleave\", () => {\r\n                        btn.style.animationPlayState = \"running\";\r\n                    });\r\n                });\r\n            </script>\r\n            <!--輪播-->\r\n            <div class=\"banner\">\r\n                <!-- Swiper -->\r\n                <div class=\"swiper mySwiper swiper-container_pc\">\r\n                    <div class=\"swiper-wrapper\">\r\n                        <div class=\"swiper-slide\">\r\n                            <a href=\"#\">\r\n                                <div class=\"bannerList\">\r\n                                    <div class=\"bannerContent\">\r\n                                        <div class=\"bannerImg\"  id=\"bannerImg\" \r\n                                                                data-aos=\"zoom-in\" \r\n                                                                data-aos-delay=\"800\" \r\n                                                                data-aos-duration=\"1500\" \r\n                                                                data-aos-anchor=\"#bannerImg\"\r\n                                                                data-aos-anchor-placement=\"bottom\" \r\n                                                                data-aos-once=\"true\"\r\n                                                                data-aos-easing=\"ease-in-sine\">\r\n                                            <img src=\"web/index/images/banner_pic.png\" alt=\"\">\r\n                                        </div>\r\n                                        <div class=\"bannerText\" id=\"bannerText\" \r\n                                        