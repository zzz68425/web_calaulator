 function gtag(){dataLayer.push(arguments);}\r\n  gtag('js', new Date());\r\n\r\n  gtag('config', 'G-18GQVSF8KR');\r\n</script><meta property=\"og:url\"           content=\"https://www.ipcfgrant.ipcf.org.tw/home.jsp?lang=tw\" />\r\n\t<meta property=\"og:type\"          content=\"website\" />\r\n\t<meta property=\"og:title\"         content=\"財團法人原住民族文化事業基金會\" />\r\n\t<meta property=\"og:description\"   content=\"財團法人原住民族文化事業基金會 文化藝術補助申請平台\" />\r\n\t<meta property=\"og:image\"         content=\"https://www.ipcfgrant.ipcf.org.tw/web/images/logo.png\" />\r\n\t\r\n\t<script type=\"text/javascript\">\r\n\t\t\r\n\t\tfunction checklogin(F) {\r\n\t\t\tvar isEmail = /^([A-Za-z0-9_\\-\\.])+\\@([A-Za-z0-9_\\-\\.])+\\.([A-Za-z]{2,4})$/;  \t// E-Mail格式\r\n\t\t\tvar chk_pss = /^(?=.*[A-Za-z])(?=.*\\d)[A-Za-z\\d]{6,15}$/;  \t\t\t\t\t\t// 密碼格式\r\n\t\r\n\t\t\tif (!isEmail.test(F.qaccount.value)) {\r\n\t\t        alert(\"請輸入您的帳號(E-mail)!!\");\r\n\t\t        F.qaccount.focus();\r\n\t\t\t} else if (!chk_pss.test(F.qpwd.value)) {\r\n\t\t        alert(\"請輸入正確的密碼!!\");\r\n\t\t        F.qpwd.focus();\r\n\t\t\t} else if (F.ind.value == \"\") {\r\n\t\t\t    alert(\"請輸入驗證碼!!\");\r\n\t\t\t    F.ind.focus();\r\n\t\t    } else {\r\n\t\t        return true;\r\n\t\t    }\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\t\r\n\t\t\r\n\t\tfunction loadimage() { \r\n            document.getElementById(\"randImage\").src = \"comm/image.jsp?\"+Math.random(); \r\n        }\r\n\t\t\r\n\t\t$(document).ready(function(){\r\n\t\t\tloadimage();\t\t\t// 重整驗證碼\r\n\t\t\t$('#qaccount').focus();\r\n\t\t});\r\n\t</script>\r\n\t\r\n</head>\r\n\r\n<body>\r\n\t<!-- <div id=\"homebody\" style=\"background: linear-gradient(#e0f0ff, #67e5ff) , url(../images/bg.png);\">    -->\r\n\r\n    <div class=\"headertop\" id=\"top\"></div>\r\n\r\n    <!--版頭-->\r\n    <header class=\"header\">\r\n    \t<div class=\"wrap\">\r\n\r\n            <!--手機menu按鍵-->\r\n            <div class=\"menu_btn\">\r\n                <span>\r\n                </span>\r\n                <span>\r\n                </span>\r\n                <span>\r\n                </span>\r\n            </div>\r\n            \r\n            <!--公司標誌 logo-->\r\n            <h1 class=\"logo\">\r\n            \t<a href=\"home.jsp\">\r\n                \t\r\n                    <div class=\"img\">\r\n                        <img src=\"web/images/logo.png\" width=\"716\" height=\"153\" />\r\n                    </div>\r\n                </a>\r\n            </h1>\r\n\r\n            <!-- 版頭右 -->\r\n            <div class=\"header_rightArea\">\r\n\r\n                <!--主按鍵 navbar-->\r\n                <div class=\"navbar\">\r\n                    \r\n                    <!-- 文化藝術補助申請 -->\r\n                    <div class=\"nav\">\r\n                        <a href=\"web/member/member_personal.jsp\">\r\n                            文化藝術補助申請\r\n                        </a>\r\n                    </div>\r\n                    \r\n                    <div class=\"clearfloat\">\r\n                    </div>\r\n\r\n                </div>\r\n\r\n            </div>\r\n\r\n            <div class=\"clearfloat\">\r\n            </div>\r\n\r\n        </div>\r\n    </header>\r\n    \r\n    \r\n    \r\n    \r\n    <!--主內容區塊-->\r\n    <main class=\"main inmain\">\r\n\r\n          <!--會員登入內容區塊-->\r\n          <div class=\"pageContent_login\">\r\n            <div class=\"wrap\">\r\n                \r\n                <!-- 會員登入區塊 -->\r\n                <div class=\"member_loginBg\">\r\n                    <div class=\"member_loginIn\">\r\n\r\n                        <!-- 標題 -->\r\n                        <div class=\"title\">\r\n                            登入  \r\n                        </div>\r\n\r\n                        <!-- 登入內容區塊 -->\r\n                        <div class=\"login_contentBg\">\r\n                            <div class=\"login_contentIn\">\r\n                            \r\n                            \t<form name=\"form_login\" method=\"post\" action=\"web/member/member_update.jsp?action=login\" onsubmit=\"return checklogin(this);\">\r\n                            \r\n\r\n\t                                <!-- 表單區塊 -->\r\n\t                                <div class=\"form_listBg\">\r\n\t                                    <div class=\"form_listArea\">\r\n\t\r\n\t                                        <!-- 列表 -->\r\n\t                                        <div class=\"form_list\">\r\n\t                                            <!-- 標題 -->\r\n\t                                            <div class=\"title\">\r\n\t                                                帳號： \r\n\t                                            </div>\r\n\t                                            \r\n\t                                            <!-- 內容 -->\r\n\t                                            <div class=\"content\">\r\n\t                                                <input type=\"email\" name=\"qaccount\" id=\"qaccount\" placeholder=\"請輸入您的帳號 (E-mail)\">\r\n\t                                            </div>\r\n\t                                        </div>\r\n\t\r\n\t                                        <!-- 列表 -->\r\n\t                                        <div class=\"form_list\">\r\n\t                                            <!-- 標題 -->\r\n\t                                            <div class=\"title\">\r\n\t                                                密碼： \r\n\t                                            </div>\r\n\t                                            \r\n\t                                            <!-- 內容 -->\r\n\t                                            <div class=\"content password\">\r\n\t                                                <div class=\"password_icon\" id=\"eye1\">\r\n\t                                                    <i class=\"bi bi-eye-slash-fill\"></i>\r\n\t                                                </div>   \r\n\t                                                <input title=\"密碼\" name=\"qpwd\" id=\"password1\" type=\"password\" placeholder=\"\" />\r\n\t                                            </div>\r\n\t                                        </div>\r\n\t\r\n\t                                        <!--驗證碼-->\r\n\t                                        <div class=\"form_list \">\r\n\t                                            <div class=\"title\">\r\n\t                                                驗證碼：\r\n\t                                                <!-- <div class=\"requirde_icon\">\r\n\t                                                    必填\r\n\t                                                </div> -->\r\n\t                                            </div>\r\n\t                                            <div class=\"content captcha no_border\">\r\n\t                                                <input type=\"text\" name=\"ind\" id=\"ind\" placeholder=\"驗證碼\" title=\"驗證碼\" />\r\n\t                                                <img src=\"comm/image.jsp\" alt=\"驗證碼圖片\" title=\"驗證碼圖片\" name=\"randImage\"\r\n\t                                                    id=\"randImage\" width=\"72\" height=\"27\" />\r\n\t\r\n\t                                                <a href=\"javascript:loadimage();\">\r\n\t                                                    重取驗證碼\r\n\t                                                </a>\r\n\t                                                <span>\r\n\t                                                    (請注意英文字母大小寫！)\r\n\t                                                </span>\r\n\t\r\n\t                                            </div>\r\n\t                                        </div>\r\n\t\r\n\t                                        <!-- 列表 --><!-- 登入按鈕 -->\r\n\t                                        <div class=\"form_list login_button\">\r\n\t                                            <input type=\"hidden\" name=\"csrf_token\" value=\"GOm1MO7nCslp5WlRSPsMnw\" />\r\n                            \t\t\t\t\t<input type=\"submit\" value=\"登入\">\r\n\t                                        </div>\r\n\t\r\n\t                                    </div>\r\n\t                                </div>\r\n                                </form>\r\n\r\n                                 <!-- 裝飾區塊 -->\r\n                                <div class=\"deco_bg\">\r\n                                    <div class=\"cartContent\">\r\n\r\n                                        <div class=\"deco_line\"></div>\r\n                                        <div class=\"deco_text\">或</div>\r\n                                        <div class=\"deco_line\"></div>\r\n\r\n                                    </div>\r\n                                </div>\r\n\r\n                                 <!-- 其他功能區塊 -->\r\n                                <div class=\"other_bg\">\r\n                                    <div class=\"cartContent\">\r\n        \r\n                                        <div class=\"other_list\">\r\n                                            <a href=\"web/member/forget_password.jsp\" title=\"前往忘記密碼頁面\">忘記密碼 ?</a>\r\n                                        </div>\r\n        \r\n                                        <div class=\"other_list\">\r\n                                            <a href=\"web/member/add.jsp\" title=\"前往加入會員頁面\">會員註冊</a>\r\n                                        </div>\r\n        \r\n                                        <div class=\"clearfloat\"></div>\r\n                                    </div>\r\n                                </div>\r\n\r\n\r\n                            </div>\r\n                        </div>\r\n                        \r\n                        \r\n                    </div>\r\n                </div>\r\n                \r\n            </div>\r\n        </div>     \r\n        \r\n    </main>  \r\n    \r\n    \r\n    \r\n<script>\r\n\r\n    //----------------------------------密碼開關樣式----------------------------------\r\n    $(document).ready(function() {\r\n    \r\n        $(\"#eye1\").click(function () {\r\n            // 切換第一個密碼輸入框的類型\r\n            if ($(\"#password1\").attr('type') === 'password') {\r\n                $(\"#password1\").attr('type', 'text');\r\n                //console.log(\"開眼1\");\r\n            } else {\r\n                $(\"#password1\").attr('type', 'password');\r\n                //console.log(\"閉眼1\");\r\n            }\r\n            $(this).children().toggleClass('bi-eye-slash-fill');\r\n            $(this).children().toggleClass('bi-eye-fill');\r\n        });\r\n    \r\n    // 閉眼 Class ： bi bi-eye-slash-fill\r\n    // 開眼 Class ： bi bi-eye-fill\r\n    \r\n    });\r\n    \r\n    </script>\r\n    \r\n    <!--版腳-->\r\n\t <footer class=\"footer\"> \r\n\r\n    \t<!--浮動top鍵--><!--js在common.js內-->\r\n       <div class=\"topBtn\">\r\n            <a href=\"#top\">\r\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"currentColor\"\r\n                    class=\"bi bi-chevron-up\" viewBox=\"0 0 16 16\">\r\n                    <path fill-rule=\"evenodd\"\r\n                        d=\"M7.646 4.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1-.708.708L8 5.707l-5.646 5.647a.5.5 0 0 1-.708-.708l6-6z\" />\r\n                </svg>\r\n            \t<span>TOP</span>\r\n            </a>\r\n        </div>\r\n        \r\n        <div class=\"wrap\"> \r\n\r\n            <!--版腳內容區塊-->\r\n            <div class=\"footer_content\">   \r\n                             \r\n                <!--公司標誌 footer_logo-->\r\n                 <div class=\"footer_logo\">\r\n                    <a href=\"web/member/login.jsp\">\r\n                        <div class=\"img\">\r\n                            <img src=\"web/images/logo02.png\" />\r\n                        </div>                        \r\n                    </a>\r\n                </div> \r\n\r\n                <!--版腳資訊 footer_information-->\r\n           